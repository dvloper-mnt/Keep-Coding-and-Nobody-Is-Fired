{
  "name": "hackathon",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:questions": "tsx scripts/generate-questions.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1094.0",
    "ioredis": "^5.11.1",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "js-yaml@<4.3.0": ">=4.3.0",
      "sharp@<0.35.0": ">=0.35.0",
      "@eslint/config-array": "^0.23.5",
      "@eslint/eslintrc": "^3.3.6",
      "brace-expansion": "5.0.8"
    }
  }
}
